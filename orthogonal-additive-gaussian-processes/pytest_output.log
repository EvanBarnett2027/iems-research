            model.kernel.kernels[2].kernels[1].base_kernel.lengthscales.assign(4.499)
            model.kernel.kernels[2].kernels[1].base_kernel.variance.assign(1.00)
            # constant term
            model.kernel.kernels[3].variance.assign(1.00)
