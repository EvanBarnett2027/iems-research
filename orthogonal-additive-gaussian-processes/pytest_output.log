                sparse_gp = True
            else:
                model = GPR(
                    data,
                    kernel=np.sum(
                        grammer_to_kernel(
                            selected_dims, offset, GaussianMeasure(mu, delta ** 2)
                        )
                    ),
                )
                sparse_gp = False
            model.kernel.kernels[0].base_kernel.variance.assign(99.98)
            model.kernel.kernels[0].base_kernel.lengthscales.assign(2.75)
